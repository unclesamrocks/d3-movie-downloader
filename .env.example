# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# Database
DB_PATH=/app/data/bot.db

# Temp directory for downloads
TEMP_DIR=/app/temp

# Limits
MAX_CONCURRENT_DOWNLOADS=1
MAX_DISK_USAGE_MB=1024

# Server
PORT=3000

# Environment
NODE_ENV=production