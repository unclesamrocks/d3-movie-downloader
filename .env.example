# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# Database
DB_PATH=/app/data/bot.db

# Temp directory for downloads
TEMP_DIR=/app/temp

# Limits
MAX_CONCURRENT_DOWNLOADS=1

# Server
PORT=3000

# Optional Go runtime diagnostics (keep private; do not proxy publicly)
PPROF_ENABLED=false
PPROF_PORT=6060
# Docker host port, bound only to VPS loopback for local/SSH-tunnel access
PPROF_HOST_PORT=6060

# Environment
NODE_ENV=production
